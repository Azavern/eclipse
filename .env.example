# Server-only. Tidak ada variabel NEXT_PUBLIC_* karena tidak ada Supabase client
# di browser (blueprint §3.2-3): semua baca/tulis lewat Server Component dan
# Server Action dengan cookie sesi httpOnly.

# URL proyek Supabase, contoh: https://abcdefghijklm.supabase.co
SUPABASE_URL=
# Kunci publishable/anon. Dipakai client JWT user di server (RLS aktif).
SUPABASE_PUBLISHABLE_KEY=
# Kunci service_role / secret. HANYA untuk Auth Admin API dan cleanup Storage.
# Jangan pernah masuk ke kode klien, log, atau Next.js config.
SUPABASE_SECRET_KEY=

# Dasar URL tautan akses sekali pakai, tanpa slash akhir.
APP_URL=http://localhost:3000

# Token acak minimal 32 karakter untuk header Authorization /api/health.
CRON_SECRET=

# Hanya untuk skrip lokal (scripts/bootstrap-admin.ts). Jangan diset di Vercel.
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_NAME=
